APP_NAME="Aurelia"
APP_TAGLINE="Considered goods for everyday life"
APP_URL=http://localhost:8000
APP_DEBUG=true
APP_CURRENCY=USD
APP_CURRENCY_SYMBOL=$

# sqlite (zero-config demo) or mysql (production)
DB_DRIVER=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=aurelia
DB_USERNAME=root
DB_PASSWORD=

# demo = built-in sandbox page, stripe = live Stripe Checkout
PAYMENT_DRIVER=demo
STRIPE_SECRET=
STRIPE_PUBLISHABLE=
STRIPE_WEBHOOK_SECRET=

# log = write to storage/logs/mail.log, mail = PHP mail()
MAIL_DRIVER=log
MAIL_FROM=orders@example.test
MAIL_FROM_NAME="Aurelia Orders"
